@model DemoMVC.Models.Student

<h2 class="mt-4 text-danger">Xóa sinh viên</h2>

<h4>Bạn có chắc muốn xóa không?</h4>

<div>
    <p><b>Mã sinh viên:</b> @Model.StudentCode</p>
    <p><b>Họ tên:</b> @Model.Name</p>
    <p><b>Tuổi:</b> @Model.Age</p>
    <p><b>Email:</b> @Model.Email</p>
    <p><b>Khoa:</b> @(Model.Faculty?.FacultyName ?? "Chưa có khoa")</p>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
