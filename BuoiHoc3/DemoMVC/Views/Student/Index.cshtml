@model IEnumerable<DemoMVC.Models.ViewModels.StudentVM>

<h2 class="mt-4">Danh sách sinh viên</h2>

<p>
    <a asp-action="Create" asp-controller="Student" class="btn btn-success mb-3">
        + Thêm sinh viên
    </a>
    <a asp-action="UploadExcel" asp-controller="Student" class="btn btn-outline-primary mb-3 ms-2">
        Upload Excel
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Mã sinh viên</th>
            <th>Họ tên</th>
            <th>Tuổi</th>
            <th>Email</th>
            <th>Khoa</th>
            <th style="width:150px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentCode</td>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Email</td>
                    <td>@(string.IsNullOrEmpty(item.FacultyName) ? "Chưa có khoa" : item.FacultyName)</td>
                    <td>
                        <a asp-action="Edit"
                           asp-controller="Student"
                           asp-route-id="@item.StudentId"
                           class="btn btn-primary btn-sm">
                            Sửa
                        </a>

                        <a asp-action="Delete"
                           asp-controller="Student"
                           asp-route-id="@item.StudentId"
                           class="btn btn-danger btn-sm">
                            Xóa
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">
                    Chưa có sinh viên nào
                </td>
            </tr>
        }
    </tbody>
</table>
