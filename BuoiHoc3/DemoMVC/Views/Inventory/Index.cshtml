@model DemoMVC.Models.ViewModels.InventoryVM

@{
    ViewData["Title"] = "Quan ly kho";
}

<h2 class="mt-3">Quan ly kho thiet bi dien tu</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tim thiet bi hoac loai thiet bi" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" type="submit">Tim kiem</button>
    </div>
</form>

<div class="row">
    <div class="col-md-4">
        <h4>Nha cung cap</h4>
        <form asp-action="SaveSupplier" method="post" class="mb-3">
            <input asp-for="Supplier.SupplierName" name="SupplierName" class="form-control mb-2" placeholder="Ten nha cung cap" />
            <input asp-for="Supplier.Address" name="Address" class="form-control mb-2" placeholder="Dia chi" />
            <input asp-for="Supplier.Phone" name="Phone" class="form-control mb-2" placeholder="So dien thoai" />
            <button class="btn btn-success" type="submit">Them</button>
        </form>

        <table class="table table-sm table-bordered">
            <tr>
                <th>Ten</th>
                <th></th>
            </tr>
            @foreach (var item in Model.Suppliers)
            {
                <tr>
                    <td>@item.SupplierName</td>
                    <td>
                        <form asp-action="DeleteSupplier" method="post">
                            <input type="hidden" name="id" value="@item.SupplierId" />
                            <button class="btn btn-danger btn-sm">Xoa</button>
                        </form>
                    </td>
                </tr>
            }
        </table>
    </div>

    <div class="col-md-4">
        <h4>Loai thiet bi</h4>
        <form asp-action="SaveCategory" method="post" class="mb-3">
            <input asp-for="Category.CategoryName" name="CategoryName" class="form-control mb-2" placeholder="Ten loai thiet bi" />
            <button class="btn btn-success" type="submit">Them</button>
        </form>

        <table class="table table-sm table-bordered">
            <tr>
                <th>Ten loai</th>
                <th></th>
            </tr>
            @foreach (var item in Model.Categories)
            {
                <tr>
                    <td>@item.CategoryName</td>
                    <td>
                        <form asp-action="DeleteCategory" method="post">
                            <input type="hidden" name="id" value="@item.DeviceCategoryId" />
                            <button class="btn btn-danger btn-sm">Xoa</button>
                        </form>
                    </td>
                </tr>
            }
        </table>
    </div>

    <div class="col-md-4">
        <h4>Thiet bi</h4>
        <form asp-action="SaveDevice" method="post" class="mb-3">
            <input asp-for="Device.DeviceCode" name="DeviceCode" class="form-control mb-2" placeholder="Ma thiet bi" />
            <input asp-for="Device.DeviceName" name="DeviceName" class="form-control mb-2" placeholder="Ten thiet bi" />
            <input asp-for="Device.Quantity" name="Quantity" class="form-control mb-2" placeholder="So luong ton" />
            <input asp-for="Device.Price" name="Price" class="form-control mb-2" placeholder="Don gia" />
            <select asp-for="Device.DeviceCategoryId" name="DeviceCategoryId" asp-items="Model.CategoryOptions" class="form-select mb-2">
                <option value="">-- Chon loai --</option>
            </select>
            <select asp-for="Device.SupplierId" name="SupplierId" asp-items="Model.SupplierOptions" class="form-select mb-2">
                <option value="">-- Chon nha cung cap --</option>
            </select>
            <button class="btn btn-success" type="submit">Them</button>
        </form>
    </div>
</div>

<h4 class="mt-4">Danh sach thiet bi</h4>
<table class="table table-bordered table-striped">
    <tr>
        <th>Ma</th>
        <th>Ten</th>
        <th>Loai</th>
        <th>Nha cung cap</th>
        <th>Ton</th>
        <th>Don gia</th>
        <th></th>
    </tr>
    @foreach (var item in Model.Devices)
    {
        <tr>
            <td>@item.DeviceCode</td>
            <td>@item.DeviceName</td>
            <td>@item.CategoryName</td>
            <td>@item.SupplierName</td>
            <td>@item.Quantity</td>
            <td>@item.Price.ToString("N0")</td>
            <td>
                <form asp-action="DeleteDevice" method="post">
                    <input type="hidden" name="id" value="@item.DeviceId" />
                    <button class="btn btn-danger btn-sm">Xoa</button>
                </form>
            </td>
        </tr>
    }
</table>

<div class="row mt-4">
    <div class="col-md-6">
        <h4>Nhap kho</h4>
        <form asp-action="Import" method="post">
            <input asp-for="ImportForm.Date" name="Date" type="date" class="form-control mb-2" />
            <input asp-for="ImportForm.Note" name="Note" class="form-control mb-2" placeholder="Ghi chu" />

            @for (var i = 0; i < Model.ImportForm.Lines.Count; i++)
            {
                <div class="row g-2 mb-2">
                    <div class="col-5">
                        <select name="Lines[@i].DeviceId" asp-items="Model.DeviceOptions" class="form-select">
                            <option value="">-- Thiet bi --</option>
                        </select>
                    </div>
                    <div class="col-3">
                        <input name="Lines[@i].Quantity" class="form-control" placeholder="SL" />
                    </div>
                    <div class="col-4">
                        <input name="Lines[@i].Price" class="form-control" placeholder="Gia nhap" />
                    </div>
                </div>
            }

            <button class="btn btn-primary" type="submit">Luu phieu nhap</button>
        </form>
    </div>

    <div class="col-md-6">
        <h4>Xuat kho</h4>
        <form asp-action="Export" method="post">
            <input asp-for="ExportForm.Date" name="Date" type="date" class="form-control mb-2" />
            <input asp-for="ExportForm.Note" name="Note" class="form-control mb-2" placeholder="Ghi chu" />

            @for (var i = 0; i < Model.ExportForm.Lines.Count; i++)
            {
                <div class="row g-2 mb-2">
                    <div class="col-5">
                        <select name="Lines[@i].DeviceId" asp-items="Model.DeviceOptions" class="form-select">
                            <option value="">-- Thiet bi --</option>
                        </select>
                    </div>
                    <div class="col-3">
                        <input name="Lines[@i].Quantity" class="form-control" placeholder="SL" />
                    </div>
                    <div class="col-4">
                        <input name="Lines[@i].Price" class="form-control" placeholder="Gia xuat" />
                    </div>
                </div>
            }

            <button class="btn btn-warning" type="submit">Luu phieu xuat</button>
        </form>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <h4>Phieu nhap</h4>
        <table class="table table-sm table-bordered">
            <tr>
                <th>Ngay</th>
                <th>Ghi chu</th>
                <th>Tong tien</th>
            </tr>
            @foreach (var item in Model.ImportReceipts)
            {
                <tr>
                    <td>@item.Date.ToString("dd/MM/yyyy")</td>
                    <td>@item.Note</td>
                    <td>@item.Total.ToString("N0")</td>
                </tr>
            }
        </table>
    </div>

    <div class="col-md-6">
        <h4>Phieu xuat</h4>
        <table class="table table-sm table-bordered">
            <tr>
                <th>Ngay</th>
                <th>Ghi chu</th>
                <th>Tong tien</th>
            </tr>
            @foreach (var item in Model.ExportReceipts)
            {
                <tr>
                    <td>@item.Date.ToString("dd/MM/yyyy")</td>
                    <td>@item.Note</td>
                    <td>@item.Total.ToString("N0")</td>
                </tr>
            }
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
