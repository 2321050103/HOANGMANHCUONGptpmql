@model IEnumerable<DemoMVC.Models.Supplier>
@{
    ViewData["Title"] = "Nha cung cap";
}

<h2>Nha cung cap</h2>

<input type="hidden" id="supplierId" />

<h5 id="formTitle">Them nha cung cap</h5>
<div class="row g-2 mb-3">
    <div class="col-md-3">
        <input id="supplierName" class="form-control" placeholder="Ten nha cung cap" />
    </div>
    <div class="col-md-4">
        <input id="address" class="form-control" placeholder="Dia chi" />
    </div>
    <div class="col-md-3">
        <input id="phone" class="form-control" placeholder="So dien thoai" />
    </div>
    <div class="col-md-1">
        <button type="button" class="btn btn-success w-100" onclick="saveSupplier()">Luu</button>
    </div>
    <div class="col-md-1">
        <button type="button" class="btn btn-secondary w-100" onclick="clearSupplierForm()">Moi</button>
    </div>
</div>

<div id="message" class="mb-3"></div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Ten nha cung cap</th>
            <th>Dia chi</th>
            <th>So dien thoai</th>
            <th style="width:160px">Thao tac</th>
        </tr>
    </thead>
    <tbody id="supplierTable">
        <tr>
            <td colspan="4" class="text-center text-muted">Dang tai du lieu...</td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <script>
        let suppliers = [];

        document.addEventListener('DOMContentLoaded', loadSuppliers);

        function loadSuppliers() {
            fetch('/Suppliers/GetSuppliers')
                .then(response => response.json())
                .then(data => {
                    suppliers = data;
                    let html = '';

                    if (data.length === 0) {
                        html = '<tr><td colspan="4" class="text-center text-muted">Chua co nha cung cap nao</td></tr>';
                    } else {
                        data.forEach(supplier => {
                            html += `
                                <tr>
                                    <td>${escapeHtml(supplier.supplierName)}</td>
                                    <td>${escapeHtml(supplier.address || '')}</td>
                                    <td>${escapeHtml(supplier.phone || '')}</td>
                                    <td>
                                        <button type="button" class="btn btn-primary btn-sm" onclick="editSupplier(${supplier.supplierId})">Sua</button>
                                        <button type="button" class="btn btn-danger btn-sm" onclick="deleteSupplier(${supplier.supplierId})">Xoa</button>
                                    </td>
                                </tr>
                            `;
                        });
                    }

                    document.getElementById('supplierTable').innerHTML = html;
                })
                .catch(() => showMessage('Khong tai duoc danh sach nha cung cap.', 'danger'));
        }

        function saveSupplier() {
            const id = document.getElementById('supplierId').value;
            const supplier = {
                supplierId: id ? parseInt(id) : 0,
                supplierName: document.getElementById('supplierName').value.trim(),
                address: document.getElementById('address').value.trim(),
                phone: document.getElementById('phone').value.trim()
            };

            if (!supplier.supplierName) {
                showMessage('Vui long nhap ten nha cung cap.', 'warning');
                return;
            }

            fetch('/Suppliers/AjaxSave', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(supplier)
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error();
                    }

                    return response.json();
                })
                .then(() => {
                    clearSupplierForm();
                    loadSuppliers();
                    showMessage('Luu nha cung cap thanh cong.', 'success');
                })
                .catch(() => showMessage('Khong luu duoc nha cung cap.', 'danger'));
        }

        function editSupplier(id) {
            const supplier = suppliers.find(item => item.supplierId === id);
            if (!supplier) {
                return;
            }

            document.getElementById('supplierId').value = supplier.supplierId;
            document.getElementById('supplierName').value = supplier.supplierName;
            document.getElementById('address').value = supplier.address || '';
            document.getElementById('phone').value = supplier.phone || '';
            document.getElementById('formTitle').textContent = 'Cap nhat nha cung cap';
        }

        function deleteSupplier(id) {
            if (!confirm('Ban co chac muon xoa nha cung cap nay?')) {
                return;
            }

            fetch('/Suppliers/AjaxDelete?id=' + id, { method: 'POST' })
                .then(response => {
                    if (!response.ok) {
                        throw new Error();
                    }

                    return response.json();
                })
                .then(() => {
                    clearSupplierForm();
                    loadSuppliers();
                    showMessage('Xoa nha cung cap thanh cong.', 'success');
                })
                .catch(() => showMessage('Khong xoa duoc. Nha cung cap co the dang duoc thiet bi su dung.', 'danger'));
        }

        function clearSupplierForm() {
            document.getElementById('supplierId').value = '';
            document.getElementById('supplierName').value = '';
            document.getElementById('address').value = '';
            document.getElementById('phone').value = '';
            document.getElementById('formTitle').textContent = 'Them nha cung cap';
        }

        function showMessage(text, type) {
            document.getElementById('message').innerHTML =
                `<div class="alert alert-${type} py-2 mb-0">${escapeHtml(text)}</div>`;
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }
    </script>
}
