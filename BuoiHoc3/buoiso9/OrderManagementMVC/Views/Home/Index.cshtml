@{
    ViewData["Title"] = "Trang chu";
}

<div class="text-center">
    <h1 class="display-4">Quan ly don hang</h1>
    <p>Ung dung quan ly khach hang, san pham, don hang va chi tiet don hang.</p>
</div>

<div class="row mt-4">
    <div class="col-md-3 mb-3">
        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-primary w-100">Quan ly khach hang</a>
    </div>
    <div class="col-md-3 mb-3">
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success w-100">Quan ly san pham</a>
    </div>
    <div class="col-md-3 mb-3">
        <a asp-controller="Order" asp-action="Index" class="btn btn-outline-warning w-100">Quan ly don hang</a>
    </div>
    <div class="col-md-3 mb-3">
        <a asp-controller="OrderDetail" asp-action="Index" class="btn btn-outline-dark w-100">Chi tiet don hang</a>
    </div>
</div>
