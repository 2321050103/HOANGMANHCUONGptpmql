@model OrderManagementMVC.Models.OrderDetail

@{
    ViewData["Title"] = "Xoa chi tiet don hang";
}

<h2>Xoa chi tiet don hang</h2>

<div class="alert alert-warning">Ban co chac muon xoa dong chi tiet nay khong?</div>

<dl class="row">
    <dt class="col-sm-3">Don hang</dt>
    <dd class="col-sm-9">#@Model.OrderId - @Model.Order?.Customer?.Name</dd>

    <dt class="col-sm-3">San pham</dt>
    <dd class="col-sm-9">@Model.Product?.Name</dd>

    <dt class="col-sm-3">So luong</dt>
    <dd class="col-sm-9">@Model.Quantity</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Xoa</button>
    <a asp-action="Index" class="btn btn-secondary">Huy</a>
</form>
