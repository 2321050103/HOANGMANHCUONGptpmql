@model OrderManagementMVC.Models.OrderDetail

@{
    ViewData["Title"] = "Chi tiet dong san pham";
}

<h2>Chi tiet dong san pham</h2>

<dl class="row">
    <dt class="col-sm-3">Ma dong</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Don hang</dt>
    <dd class="col-sm-9">#@Model.OrderId - @Model.Order?.Customer?.Name</dd>

    <dt class="col-sm-3">San pham</dt>
    <dd class="col-sm-9">@Model.Product?.Name</dd>

    <dt class="col-sm-3">So luong</dt>
    <dd class="col-sm-9">@Model.Quantity</dd>

    <dt class="col-sm-3">Don gia</dt>
    <dd class="col-sm-9">@Model.Price.ToString("N0")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sua</a>
<a asp-action="Index" class="btn btn-secondary">Quay lai</a>
