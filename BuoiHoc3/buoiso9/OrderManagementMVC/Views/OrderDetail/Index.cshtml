@model IEnumerable<OrderManagementMVC.Models.OrderDetail>

@{
    ViewData["Title"] = "Chi tiet don hang";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sach chi tiet don hang</h2>
    <a asp-action="Create" class="btn btn-primary">Them chi tiet</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ma</th>
            <th>Don hang</th>
            <th>Khach hang</th>
            <th>San pham</th>
            <th>So luong</th>
            <th>Don gia</th>
            <th>Thanh tien</th>
            <th class="text-center">Thao tac</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>#@item.OrderId</td>
            <td>@item.Order?.Customer?.Name</td>
            <td>@item.Product?.Name</td>
            <td>@item.Quantity</td>
            <td>@item.Price.ToString("N0")</td>
            <td>@((item.Quantity * item.Price).ToString("N0"))</td>
            <td class="text-center">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Chi tiet</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sua</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xoa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
