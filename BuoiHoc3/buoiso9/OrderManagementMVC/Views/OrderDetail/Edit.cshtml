@model OrderManagementMVC.Models.OrderDetail

@{
    ViewData["Title"] = "Sua chi tiet don hang";
}

<h2>Sua chi tiet don hang</h2>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="OrderId" class="form-label"></label>
        <select asp-for="OrderId" asp-items="ViewBag.OrderId" class="form-select"></select>
        <span asp-validation-for="OrderId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductId" class="form-label"></label>
        <select asp-for="ProductId" asp-items="ViewBag.ProductId" class="form-select"></select>
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Cap nhat</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lai</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
