@model OrderManagementMVC.Models.Customer

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<h2>Chi tiết khách hàng</h2>

<dl class="row">
    <dt class="col-sm-3">Max khách hàng</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Số đơn hàng</dt>
    <dd class="col-sm-9">@Model.Orders.Count</dd>
</dl>

<a asp-controller="Order" asp-action="OrdersByCustomer" asp-route-customerId="@Model.Id" class="btn btn-info">Xem don hang da mua</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lai</a>
