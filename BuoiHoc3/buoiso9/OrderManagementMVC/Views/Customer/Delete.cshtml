@model OrderManagementMVC.Models.Customer

@{
    ViewData["Title"] = "Xóa khach hang";
}

<h2>Xoá khách hàng</h2>

<div class="alert alert-warning">
    Ban co chac muon xoa khach hang nay khong? Tat ca don hang lien quan cung se bi xoa.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Xoá</button>
    <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
</form>
