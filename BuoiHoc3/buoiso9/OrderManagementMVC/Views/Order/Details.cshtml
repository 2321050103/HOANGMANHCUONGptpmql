@model OrderManagementMVC.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2>Chi tiết đươn hàng</h2>

<dl class="row">
    <dt class="col-sm-3">Mã đơn</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Khách hàng</dt>
    <dd class="col-sm-9">@Model.Customer?.Name</dd>

    <dt class="col-sm-3">Ngày đặt</dt>
    <dd class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Tổng tiền</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N0")</dd>
</dl>

<h4>Sản phẩm trong đơn</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành Tiền</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.OrderDetails)
    {
        <tr>
            <td>@item.Product?.Name</td>
            <td>@item.Quantity</td>
            <td>@item.Price.ToString("N0")</td>
            <td>@((item.Quantity * item.Price).ToString("N0"))</td>
        </tr>
    }
    </tbody>
</table>

<a asp-controller="OrderDetail" asp-action="Create" class="btn btn-success">Thêm chi tiết đơn hàng</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
