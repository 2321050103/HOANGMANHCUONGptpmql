@model IEnumerable<OrderManagementMVC.Models.Product>

@{
    ViewData["Title"] = "San pham";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sach san pham</h2>
    <a asp-action="Create" class="btn btn-primary">Them san pham</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ma</th>
            <th>Ten san pham</th>
            <th>Gia ban</th>
            <th>Ton kho</th>
            <th class="text-center">Thao tac</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price.ToString("N0")</td>
            <td>@item.Stock</td>
            <td class="text-center">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Chi tiet</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sua</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xoa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
